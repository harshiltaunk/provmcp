      "method": "tools/call",
      "params": {
        "name": "send",
        "arguments": {
          "to": "dana.lee@fresnostate.edu",
          "subject": "Re: Project sync",
          "body": "Running ten minutes late, sorry. Start without me."
        }
      },
      "expect_cross_origin_from": null
    }
